{
  "name": "learning-curve",
  "version": "1.0.0",
  "description": "Learning Curve: diseña una red neuronal, entrénala con aprendizaje por refuerzo y mírala aprender a disparar funciones matemáticas. Mecánica inspirada en Graphwar (Lucas Catabriga).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/server.js",
    "selfplay": "node arena/selfplay.mjs",
    "selfplay:fast": "node arena/selfplay.mjs --agents sniper,greedy,artillery,chaos --games 6 --spawn-fast",
    "test": "node test/run-all.mjs",
    "test:parser": "node test/parser.spec.mjs",
    "test:agents": "node test/agents.spec.mjs",
    "spectate": "node tools/room-debug.mjs"
  },
  "license": "UNLICENSED"
}
